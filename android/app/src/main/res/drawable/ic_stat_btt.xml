<?xml version="1.0" encoding="utf-8"?>
<!--
    Notification small icon for BTT.

    Android notification small icons are rendered as pure-white silhouettes — any
    color information is stripped by the system at draw time, so this MUST be
    monochrome white-on-transparent. The OS tints the silhouette with whatever
    `iconColor` we pass in the LocalNotifications.schedule() call (or the system
    default if we don't).

    A simple bell with a "ping" indicator: reads as "notification" instantly
    even at 24dp. Replace this file with custom BTT artwork (vector, white-only,
    24x24 viewport) any time — no JS changes needed.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Bell body -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,22c1.1,0 2,-0.9 2,-2h-4C10,21.1 10.89,22 12,22zM18,16v-5c0,-3.07 -1.64,-5.64 -4.5,-6.32V4c0,-0.83 -0.67,-1.5 -1.5,-1.5s-1.5,0.67 -1.5,1.5v0.68C7.63,5.36 6,7.92 6,11v5l-2,2v1h16v-1L18,16z" />
    <!-- Ping indicator (small dot top-right) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M19,7m-2.5,0a2.5,2.5 0,1 1,5 0a2.5,2.5 0,1 1,-5 0" />
</vector>
