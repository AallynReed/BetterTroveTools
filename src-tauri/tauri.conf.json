{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Better Trove Tools",
  "mainBinaryName": "BetterTroveTools",
  "version": "2026.10.6",
  "identifier": "net.aallyn.bettertrovetools",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' data: blob: bttapi: http://bttapi.localhost https:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost bttapi: http://bttapi.localhost https://api.aallyn.net https://trove.aallyn.net https://api.github.com https://trovesaurus.com",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": true
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["btt"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../data/": "data/",
      "../web/assets/data/": "web/assets/data/",
      "../web/assets/locale/": "web/assets/locale/",
      "../LICENSE": "LICENSE",
      "../metadata.json": "metadata.json"
    },
    "copyright": "Aallyn Reed 2026-Present",
    "shortDescription": "Better Trove Tools",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "wix": {
        "version": "26.10.6",
        "upgradeCode": "d60960b6-3eea-423f-bf8b-bfb3158531f5"
      }
    }
  }
}
