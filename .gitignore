# Ignore the virtual environment
.idea/
.venv/
.venv-linux/
.ghidra/
.claude/
.impeccable/
venv/
ENV/

# Ignore build artifacts
bin/
build/
dist/
strings/
tools/
handoff/
Better_Trove_Tools.egg-info

*.md

# Ignore Python cache
__pycache__/
*.py[cod]

# Ignore scratch files
populate_translations.py
*.php
# tools/i18n/apply_batch.py reads this path as a workspace; keep it out of git
tools/i18n/_batch.json
# One-off translation scripts (prefix-named) are throwaway — don't track them
tools/i18n/_apply_*.py

# Ignore web cache
web/cache/

# Node / Capacitor (Android build)
node_modules/
.gradle/
android/local.properties
android/app/release/
android/capacitor-cordova-android-plugins/
*.keystore
*.jks
# Defense in depth: even though the canonical release keystore lives at
# ~/.android/btt-release/ (outside the repo), refuse to commit anything that
# looks like keystore material if it lands inside the repo by accident.
keystore.properties
android/keystores/
*.apk
